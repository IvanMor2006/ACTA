<div class="modal fade modal-bottom" id="{{ modal_id }}" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered mt-auto">
        <form class="modal-content" method="post" action="{{ action_url }}">
            <div class="modal-header">
                <h5 class="modal-title">{{ 'Добавление нового дня рождения' if modal_id == 'a_dr' else 'Изменение данных' }}</h5>
                <button class="btn-close" type="button" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="form-check mb-2">
                    <label for="ae_dr_is">День рождения</label>
                    <input class="form-check-input" type="checkbox" name="ae_dr_is" id="ae_dr_is" {% if dr.ku_ol %} checked {% endif %}>
                </div>
                <div class="mb-3" id="ae_dr_div_naim">
                    <label for="ae_dr_naim">Название</label>
                    <input class="form-control" type="text" name="ae_dr_naim" id="ae_dr_naim"
                        value="{{ dr.naim if not dr.ku_ol }}" required>
                </div>
                <div class="mb-3" id="ae_dr_div_ol">
                    <label for="ae_dr_ol">Именинник</label>
                    <select class="form-select" name="ae_dr_ol" id="ae_dr_ol" required>
                        {% for person in people_ol %}
                        <option value="{{ person.ku }}|{{ person.naim | naim_rp }}" {% if dr.ku_ol == person.ku %} selected {% endif %}>
                            {{ person.naim }}
                        </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="row mb-2">
                    <div class="col-6">
                        <label for="ae_dr_event_year">Год</label>
                        <input class="form-control" type="number" name="ae_dr_event_year" id="ae_dr_event_year"
                            value="{{ dr.event_year if dr.event_year else '' }}" required>
                    </div>
                    <div class="col-6">
                        <label for="ae_dr_price">Прайс</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="nbrb-icon fs-4">BYN</i></span>
                            <input class="form-control" type="number" name="ae_dr_price" id="ae_dr_price" 
                            step="0.01" min="0.01" placeholder="7.00" value="{{ dr.price if dr.price else '7.00' }}" required>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="submit" class="btn btn-primary">Подтвердить</button>
            </div>
        </form>
    </div>
</div>
<script>
document.addEventListener('DOMContentLoaded', function () {
    const checkbox = document.getElementById('ae_dr_is');
    const divNaim = document.getElementById('ae_dr_div_naim');
    const divOl = document.getElementById('ae_dr_div_ol');
    const inputNaim = document.getElementById('ae_dr_naim');
    const selectOl = document.getElementById('ae_dr_ol');

    function toggleFields() {
        if (checkbox.checked) {
            divNaim.classList.add('d-none');
            divOl.classList.remove('d-none');
            inputNaim.required = false;
            selectOl.required = true;
        } else {
            divNaim.classList.remove('d-none');
            divOl.classList.add('d-none');
            inputNaim.required = true;
            selectOl.required = false;
        }
    }

    toggleFields();

    checkbox.addEventListener('change', toggleFields);
});
</script>