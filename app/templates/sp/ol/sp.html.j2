{% extends "base.html.j2" %}
{% block title %}Актёры{% endblock %}
{% block content %}

{% if user_role == 'admin' %}
    <button type="button" class="btn btn-primary mb-2" data-bs-toggle="modal" data-bs-target="#a_ol">
        <i class="bi bi-person-plus-fill"></i> Добавить человека
    </button>
    {% set modal_id = 'a_ol' %}
    {% set action_url = url_for('sp_ol.add') %}
    {% set person = None %}
    {% include 'sp/ol/add_edit.html.j2' %}
{% endif %}

<div class="d-md-flex gap-4">
    {% set table_title = 'Состоят в театре' %}
    {% include 'sp/ol/table.html.j2' %}

    {% if user_ku %}
        {% set table_title = 'Не состоят в театре' %}
        {% set people = people_arc %}
        {% include 'sp/ol/table.html.j2' %}
    {% endif %}
</div>

{% if user_role in ('admin', 'admin_viewer') %}
    <h4>Общий долг {{ total_debt }}<i class="nbrb-icon">BYN</i></h4>
{% endif %}

{% endblock %}