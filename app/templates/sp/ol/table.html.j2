{% if people %}
    <div class="col-md-{{ '5' if user_role in ('admin', 'admin_viewer') else '3' }} table-responsive">
        {% set thead %}
            {% if user_ku %}
                <tr><th colspan="8" class="text-center">{{ table_title }}</th></tr>
            {% endif %}
            <tr>
                <th>День<br>рождения</th>
                <th>Возраст</th>
                <th>Имя</th>
                {% if user_role in ('admin', 'admin_viewer') %}
                    <th>TG ID</th>
                    <th>Роль</th>
                    <th>Пароль</th>
                    <th>Баланс</th>
                    <th>Долг</th>
                {% endif %}
            </tr>
        {% endset %}
        {% set tbody %}
            {% for person in people %}
                <tr {% if (not person.could_pay) and (user_role in ('admin', 'admin_viewer')) %}
                        class="table-secondary"
                    {% endif %}
                    style="cursor: pointer;"
                    {% set url = url_for('sp_ol.ol', ku=person.ku) %}
                    onclick="window.location.href='{{url}}'">
                    <td {% if person.cm_dr %} class="table-warning" {% endif %}>{{ person.t_dr }}</td>
                    <td {% if person.cm_dr %} class="table-warning" {% endif %}>{{ person.age }}</td>
                    <td {% if person.cm_dr %} class="table-warning" {% endif %}>{{ person.naim }}</td>
                    {% if user_role in ('admin', 'admin_viewer') %}
                        <td>{{ person.tg_id if person.tg_id else '' }}</td>
                        <td>{{ person.role }}</td>
                        <td>{{ 'Есть' if person.password_hash else '' }}</td>
                        <td>{{ person.balance }}</td>
                        <td>{{ person.debt }}</td>
                    {% endif %}
                </tr>
            {% endfor %}
        {% endset %}
        {% include 'unit/table.html.j2' %}
    </div>
{% endif %}