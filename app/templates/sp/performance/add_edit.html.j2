<div class="modal fade modal-bottom" id="{{ modal_id }}" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered mt-auto">
        <form class="modal-content" method="post" action="{{ action_url }}" enctype="multipart/form-data">
            <div class="modal-header">
                <h5 class="modal-title">Добавление спектакля</h5>
                <button class="btn-close" type="button" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-2">
                    <label for="{{ modal_id }}_naim">Название</label>
                    <input class="form-control mb-2" type="text" name="{{ modal_id }}_naim" id="{{ modal_id }}_naim" required>
                </div>
                <div class="d-flex justify-content-between align-items-start gap-3">
                    <div class="w-100">
                        <div class="mb-2">
                            <label for="{{ modal_id }}_status">Статус</label>
                            <select class="form-select" name="{{ modal_id }}_status" id="{{ modal_id }}_status" required>
                            {% for status in play_statuses %}
                            <option value="{{ status.status }}"
                                {% if performance.status == status.status %} selected {% endif %}>
                                {{ status.status }}
                            </option>
                            {% endfor %}
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="{{ modal_id }}_premiere_date">Дата премьеры</label>
                            <div class="input-group">
                                <input class="form-control" type="date" name="{{ modal_id }}_premiere_date" id="{{ modal_id }}_premiere_date"
                                    value="{{ performance.premiere_date if performance.premiere_date else '' }}">
                            </div>
                        </div>
                        <div>
                            <label for="{{ modal_id }}_poster" class="btn border w-100">
                                <i class="bi bi-image me-2"></i> Выберите изображение
                            </label>
                            <input class="d-none" type="file" accept="image/*" name="{{ modal_id }}_poster" id="{{ modal_id }}_poster">
                        </div>
                    </div>
                    <div id="{{ modal_id }}_poster_preview" class="mt-4 card performance-card position-relative overflow-hidden d-none"></div>
                </div>
                <script>
                    const poster_input = document.getElementById('{{ modal_id }}_poster');
                    const poster_preview = document.getElementById('{{ modal_id }}_poster_preview');
                    const modal = document.getElementById('{{ modal_id }}');

                    function showPosterPrewiew(file) {
                        if (file && file.type.startsWith('image/')) {
                            const reader = new FileReader();
                            reader.onload = function(e) {
                                poster_preview.style.backgroundImage = `url(${e.target.result})`;
                                poster_preview.classList.remove('d-none');
                            }
                            reader.readAsDataURL(file);
                        } else {
                            poster_preview.classList.add('d-none');
                            poster_preview.style.backgroundImage = 'none';
                            poster_input.value = '';
                        }
                    }

                    poster_input.addEventListener('change', function() {
                        showPosterPrewiew(this.files[0]);
                    });

                    modal.addEventListener('paste', function(e) {
                        const items = (e.clipboardData || e.originalEvent.clipboardData).items;

                        for (let i = 0; i < items.length; i++) {
                            if (items[i].type.indexOf('image') !== -1) {
                                const file = items[i].getAsFile();
                                const dataTransfer = new DataTransfer();
                                dataTransfer.items.add(file);
                                poster_input.files = dataTransfer.files;

                                showPosterPrewiew(file);
                                e.preventDefault();
                                break;
                            }
                        }
                    });
                </script>
            </div>
            <div class="modal-footer">
                <button type="submit" class="btn btn-primary">Подтвердить</button>
            </div>
        </form>
    </div>
</div>