<!DOCTYPE html>
<html>
    <head>
        <meta charset='utf-8'>
        <meta name='viewport' content='width=device-width, initial-scale=1'>
        <title>{% block title %}АСТА{% endblock %}</title>
        <link rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css'>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
        <link rel="stylesheet" href="{{ url_for('static', filename='styles.css') }}">
        {% block head %}{% endblock %}
    </head>
    <body>
        <nav class="navbar navbar-expand-md navbar-dark bg-dark mb-2 mb-md-4">
            <div class="container-fluid d-flex flex-wrap align-items-center px-2 px-md-4">
                <button class="navbar-toggler order-1" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <a class="navbar-brand order-2 mx-auto ms-md-0 me-md-4" href="/">
                    <img src="{{ url_for('static', filename='logo.png') }}" alt="ACTA" class="rounded-circle"
                        style="width: 50px; height: 50px; object-fit: cover;">
                    <b class="d-none d-md-inline">Главная</b>
                </a>

                <div id="navbarMain" class="collapse navbar-collapse order-4 order-md-3">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link {% if request.path.startswith('/sp/ol') %}active{% endif %}" href="{{ url_for('sp_ol.sp') }}">
                            <i class="bi bi-people-fill"></i> Актёры
                        </a></li>
                        <li class="nav-item"><a class="nav-link {% if request.path.startswith('/sp/performance') %}active{% endif %}" href="{{ url_for('sp_performance.sp') }}">
                            <i class="bi bi-magic"></i> Спектакли
                        </a></li>
                        {% if user_ku %}
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toogle
                                  {% if request.path.startswith('/sp/dr')
                                     or request.path.startswith('/sp/card')
                                     or request.path.startswith('/sp/pay') %}active{% endif %}" href="#"
                                role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-cake2-fill"></i> Сборы
                                </a>
                                <ul class="dropdown-menu dropdown-menu-dark">
                                    <li class="dropdown-item"><a class="nav-link {% if request.path.startswith('/sp/card') %}active{% endif %}" href="{{ url_for('card') }}">
                                        <i class="bi bi-credit-card-fill"></i> Счета
                                    </a></li>
                                    <li class="dropdown-item"><a class="nav-link {% if request.path.startswith('/sp/dr') %}active{% endif %}" href="{{ url_for('sp_dr.sp') }}">
                                        <i class="bi bi-cake2-fill"></i> Планируемые
                                    </a></li>
                                    {% if user_role in ('admin', 'admin_viewer') %}
                                        <li class="dropdown-item"><a class="nav-link {% if request.path.startswith('/sp/pay') %}active{% endif %}" href="{{ url_for('sp_pay.sp') }}">
                                            <i class="bi bi-coin"></i> Долги
                                        </a></li>
                                    {% endif %}
                                </ul>
                            </li>
                        {% endif %}
                    </ul>
                </div>

                <div class="dropdown order-3 order-md-4">
                    {% if user_role == 'admin' %}
                        {% set user_clr = 'danger' %}
                    {% elif user_role == 'admin_viewer' %}
                        {% set user_clr = 'primary' %}
                    {% elif user_role == 'user' %}
                        {% set user_clr = 'success' %}
                    {% else %}
                        {% set user_clr = 'secondary' %}
                    {% endif %}
                    <button class="btn btn-{{user_clr}} rounded-circle" type="button" data-bs-toggle="dropdown" aria-expanded="false"
                            style="height: 50px; width: 50px;">
                        <i class="bi bi-person-fill fs-4"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><span class="dropdown-header fs-5" id="guestHeader">{{ user_name }}</span></li>
                        {% if user_ku %}
                            <li><a class="dropdown-item" href="{{ url_for('sp_ol.ol', ku=user_ku) }}"><i class="bi bi-person"></i> Посмотреть профиль</a></li>
                            <li><a class="dropdown-item" href="{{ url_for('auth.login', next_url=request.full_path.rstrip('?')) }}"><i class="bi bi-box-arrow-in-right"></i> Сменить аккаунт</a></li>
                            <li><a class="dropdown-item" href="{{ url_for('auth.exit', next_url=request.full_path.rstrip('?')) }}"><i class="bi bi-box-arrow-in-left"></i> Выйти</a></li>
                        {% else %}
                            <li><a class="dropdown-item" href="{{ url_for('auth.login', next_url=request.full_path.rstrip('?')) }}"><i class="bi bi-box-arrow-in-right"></i> Войти</a></li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </nav>
        {% with messages = get_flashed_messages(with_categories=true) %}
        {% if messages %}
            <div class="flash-container">
            {% for category, message in messages %}
                <div class="alert alert-{{ category }} alert-dismissible fade show shadow-sm" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
            </div>
            <script>
            (function() {
                document.addEventListener('DOMContentLoaded', function() {
                const alerts = document.querySelectorAll('.alert');
                if (alerts.length === 0) return;
                setTimeout(function() {
                    alerts.forEach(function(alert) {
                    if (alert.classList.contains('show')) {
                        if (typeof bootstrap !== 'undefined' && bootstrap.Alert) {
                        new bootstrap.Alert(alert).close();
                        } else {
                        alert.classList.remove('show');
                        alert.classList.add('d-none');
                        }
                    }
                    });
                }, 5000);
                });
            })();
            </script>
        {% endif %}
        {% endwith %}
        <div class="px-2 px-md-4">
            {% block content %}{% endblock %}
        </div>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        {% if user_role in ('admin', 'admin_viewer') %}
            <script>
            document.addEventListener('DOMContentLoaded', function() {
                const tableGroups = new Map();

                document.querySelectorAll('table').forEach((table) => {
                    const headerRows = table.querySelectorAll('thead tr');
                    if (headerRows.length === 0) return;

                    const targetHeaderRow = headerRows[headerRows.length - 1];
                    const headers = Array.from(targetHeaderRow.cells);

                    table.querySelectorAll('td, th').forEach(cell => {
                        const origSpan = parseInt(cell.getAttribute('colspan') || '1', 10);
                        cell.dataset.origColspan = origSpan;
                    });

                    const colNames = headers.map((th, colIdx) => 
                        th.innerText.replace(/\s+/g, ' ').trim() || `Столбец ${colIdx + 1}`
                    );
                    const groupKey = colNames.join('|');

                    if (!tableGroups.has(groupKey)) {
                        tableGroups.set(groupKey, {
                            colNames: colNames,
                            tables: []
                        });
                    }
                    tableGroups.get(groupKey).tables.push(table);
                });

                let groupIdx = 0;

                tableGroups.forEach((group, groupKey) => {
                    const currentGroupIdx = groupIdx++;
                    const firstTable = group.tables[0];

                    const panel = document.createElement('div');
                    panel.className = 'mb-2 p-2 border rounded bg-light d-flex flex-wrap gap-3';

                    function updateGroupTables() {
                        const checkboxes = Array.from(panel.querySelectorAll('input[type="checkbox"]'));
                        const visibilityMap = checkboxes.map(cb => cb.checked);

                        group.tables.forEach(table => {
                            table.querySelectorAll('tr').forEach(row => {
                                let currentVirtualCol = 0;

                                Array.from(row.cells).forEach(cell => {
                                    const span = parseInt(cell.dataset.origColspan || '1', 10);
                                    let visibleSubCols = 0;

                                    for (let i = 0; i < span; i++) {
                                        if (visibilityMap[currentVirtualCol + i]) {
                                            visibleSubCols++;
                                        }
                                    }

                                    if (visibleSubCols === 0) {
                                        cell.style.display = 'none';
                                    } else {
                                        cell.style.display = '';
                                        if (span > 1) {
                                            cell.setAttribute('colspan', visibleSubCols);
                                        }
                                    }

                                    currentVirtualCol += span;
                                });
                            });
                        });
                    }

                    group.colNames.forEach((colName, colIdx) => {
                        const storageKey = `tbl_grp_${currentGroupIdx}_col_${colIdx}_${colName}`;

                        const wrapper = document.createElement('div');
                        wrapper.className = 'form-check form-check-inline m-0';

                        const checkbox = document.createElement('input');
                        checkbox.type = 'checkbox';
                        checkbox.className = 'form-check-input';
                        checkbox.id = `chk-grp-${currentGroupIdx}-${colIdx}`;
                        checkbox.dataset.colIndex = colIdx;

                        const saved = localStorage.getItem(storageKey);
                        checkbox.checked = saved !== null ? (saved === 'true') : true;

                        checkbox.addEventListener('change', () => {
                            localStorage.setItem(storageKey, checkbox.checked);
                            updateGroupTables();
                        });

                        const label = document.createElement('label');
                        label.className = 'form-check-label small';
                        label.htmlFor = checkbox.id;
                        label.textContent = colName;

                        wrapper.appendChild(checkbox);
                        wrapper.appendChild(label);
                        panel.appendChild(wrapper);
                    });

                    const insertTarget = firstTable.closest('[class*="table-responsive"]') || firstTable;
                    const parent = insertTarget.parentElement;

                    if (parent) {
                        const isFlex = getComputedStyle(parent).display.includes('flex');
                        if (isFlex) {
                            parent.classList.add('flex-wrap');
                            panel.classList.add('w-100');
                        }

                        parent.insertBefore(panel, insertTarget);
                    }

                    updateGroupTables();
                });
            });
            </script>
        {% endif %}

    </body>
</html>